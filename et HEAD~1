[32m+[m[32m@use '@worktile/gantt/styles/index.scss';[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 3. Using component[m
[32m+[m
[32m+[m[32mcomponent.html[m
[32m+[m
