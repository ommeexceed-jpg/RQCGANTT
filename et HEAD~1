[32m+[m[32mThe `ngx-gantt` component accepts two data input types: `GanttItem` and `GanttGroup`. `GanttItem` refers to the Gantt chart data item format, `GanttGroup` refers to the group data format, and the specific type definitions are as follows:[m
[32m+[m
[32m+[m[32m# GanttItem[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mexport interface GanttItem<T = unknown> {[m
[32m+[m[32m  id: string;[m
[32m+[m[32m  title: string;[m
[32m+[m[32m  start?: number;[m
[32m+[m[32m  end?: number;[m
[32m+[m[32m  group_id?: string;[m
[32m+[m[32m  links?: string[];[m
[32m+[m[32m  draggable?: boolean;[m
[32m+[m[32m  linkable?: boolean;[m
[32m+[m[32m  expandable?: boolean;[m
[32m+[m[32m  expanded?: boolean;[m
[32m+[m[32m  children?: GanttItem[];[m
[32m+[m[32m  color?: string;[m
[32m+[m[32m  barStyle?: Partial<CSSStyleDeclaration>;[m
[32m+[m[32m  origin?: T;[m
[32m+[m[32m  type?: GanttItemType;[m
[32m+[m[32m  progress?: number;[m
[32m+[m[32m}[m
[32m+[m[32m```[m
