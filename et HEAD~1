[32m+[m[32m@NgModule({[m
[32m+[m[32m  ...[m
[32m+[m[32m  imports: [ NgxGanttModule, ... ][m
[32m+[m[32m  ...[m
[32m+[m[32m})[m
[32m+[m[32mexport class AppModule {[m
[32m+[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 2. Import style file in angular.json or import style in your style.scss[m
[32m+[m
[32m+[m[32m```json[m
[32m+[m[32m{[m
[32m+[m[32m  "styles": ["node_modules/@worktile/gantt/styles/index.scss"][m
[32m+[m[32m}[m
[32m+[m[32m```[m
