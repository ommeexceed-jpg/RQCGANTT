[32m+[m[32m## Usage[m
[32m+[m
[32m+[m[32m### 1. Import the NgxGanttModule to use into your app.module.ts[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mimport { NgModule } from '@angular/core';[m
